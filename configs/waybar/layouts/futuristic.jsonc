{
    "layer": "top",
    "output": ["*"],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    "modules-left": [
        "group/pill#system",
        "group/pill#session"
    ],

    "group/pill#system": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory"
        ]
    },

    "group/pill#session": {
        "orientation": "inherit",
        "modules": [
            "custom/caffeine"
        ]
    },

    "modules-center": [
        "group/pill#workspace"
    ],

    "group/pill#workspace": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces",
            "hyprland/window"
        ]
    },

    "modules-right": [
        "group/pill#hardware",
        "group/pill#status",
        "group/pill#actions"
    ],

    "group/pill#hardware": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network",
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },

    "group/pill#status": {
        "orientation": "inherit",
        "modules": [
            "custom/updates",
            "custom/keybindhint",
            "privacy",
            "tray",
            "battery"
        ]
    },

    "group/pill#actions": {
        "orientation": "inherit",
        "modules": [
            "custom/wallchange",
            "custom/theme",
            "custom/wbar",
            "custom/cliphist",
            "custom/hyde-menu",
            "custom/power"
        ]
    }
}
